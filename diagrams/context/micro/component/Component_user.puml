@startuml
title SmartHome Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(SmartHomeSystem, "SmartHome System") {
  Container(UserApplication, "User Application", "Java, Spring", "User monitoring and control application")
  Container(UserDatabase, "User Database", "PostgreSQL", "Stores Users data")
}

Container(UserApplication, "User Application", "Java, Spring") {
  Component(UserController, "UserController", "The technical layer is the controller")
  Component(UserService, "UserService", "The technical layer is the service")
  Component(UserRepository, "UserRepository", "The technical layer is the repository")
}

Rel(UserController,UserService,"Calls User business logic")
Rel(UserService,UserRepository,"Reads/Writes data")
Rel(UserRepository,UserDatabase,"Reads/Writes User data", TCP/SQL)
@enduml