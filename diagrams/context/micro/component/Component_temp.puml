@startuml
title SmartHome Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(SmartHomeSystem, "SmartHome System") {
  Container(TemperatureApplication, "Temperature Application", "Java, Spring", "Temperature monitoring and control application")
  Container(TemperatureDatabase, "Temperature Database", "PostgreSQL", "Stores temperatures data")
}

Container(TemperatureApplication, "Temperature Application", "Java, Spring") {
  Component(TemperatureController, "TemperatureController", "The technical layer is the controller")
  Component(TemperatureService, "TemperatureService", "The technical layer is the service")
  Component(TemperatureRepository, "TemperatureRepository", "The technical layer is the repository")
}

Rel(TemperatureController,TemperatureService,"Calls temperature business logic")
Rel(TemperatureService,TemperatureRepository,"Reads/Writes data")
Rel(TemperatureRepository,TemperatureDatabase,"Reads/Writes temperature data", TCP/SQL)
@enduml