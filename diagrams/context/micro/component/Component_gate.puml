@startuml
title SmartHome Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(SmartHomeSystem, "SmartHome System") {
  Container(GateApplication, "Gate Application", "Java, Spring", "Gate monitoring and control application")
  Container(GateDatabase, "Gate Database", "PostgreSQL", "Stores Gates data")
}

Container(GateApplication, "Gate Application", "Java, Spring") {
  Component(GateController, "GateController", "The technical layer is the controller")
  Component(GateService, "GateService", "The technical layer is the service")
  Component(GateRepository, "GateRepository", "The technical layer is the repository")
}

Rel(GateController,GateService,"Calls Gate business logic")
Rel(GateService,GateRepository,"Reads/Writes data")
Rel(GateRepository,GateDatabase,"Reads/Writes Gate data", TCP/SQL)
@enduml